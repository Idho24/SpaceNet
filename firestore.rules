rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsCustomer(customerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.customer_id == customerId;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'display_name',
          'photo_url',
          'created_at',
          'updated_at'
        ]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && !resource.data.keys().hasAny(['customer_id'])
        && request.resource.data.keys().hasAll([
          'customer_id',
          'phone_verified'
        ])
        && request.resource.data.customer_id is string
        && request.resource.data.phone_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customer_id',
          'phone_verified',
          'updated_at'
        ])
        && request.auth.token.phone_number is string
        && existsAfter(
          /databases/$(database)/documents/customers/$(request.resource.data.customer_id)
        )
        && getAfter(
          /databases/$(database)/documents/customers/$(request.resource.data.customer_id)
        ).data.linked_uid == uid
        && getAfter(
          /databases/$(database)/documents/customers/$(request.resource.data.customer_id)
        ).data.phone == request.auth.token.phone_number;
    }

    match /customers/{customerId} {
      allow get: if ownsCustomer(customerId);
      allow list, create, delete: if false;
      allow update: if signedIn()
        && !resource.data.keys().hasAny(['linked_uid'])
        && request.resource.data.linked_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'linked_uid'
        ])
        && request.auth.token.phone_number is string
        && resource.data.phone == request.auth.token.phone_number
        && existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.customer_id == customerId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
